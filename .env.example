# Google Drive CV link (server-side)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key; use \n for newlines when storing as a single line (e.g. on Vercel)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: used when the Drive lookup fails (e.g. the last known CV view URL)
CV_FALLBACK_URL=
